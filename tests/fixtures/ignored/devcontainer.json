{
  "name": "Docker host access, reviewed",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  // devcontainerguard-ignore DCG002 -- we need the host daemon for e2e tests
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
  ],
  "remoteUser": "root", // devcontainerguard-ignore DCG010
  "privileged": true, /* devcontainerguard-ignore */
  "capAdd": ["SYS_ADMIN"],
}
