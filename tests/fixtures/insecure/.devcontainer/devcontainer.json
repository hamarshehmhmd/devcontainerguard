  "build": { "dockerfile": "Dockerfile", "args": { "NPM_TOKEN": "npm_abcdefghijklmnopqrstuvwxyz0123456789" } },
  "privileged": true,
  "capAdd": ["SYS_ADMIN", "NET_ADMIN"],
