{
  // Hardened Python container: should produce no findings.
  "name": "Python 3",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "./local-feature": {},
  },
  "forwardPorts": [8000],
  "containerEnv": { "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}", "TOKEN_URL": "https://example.com/token" },
  "mounts": [
    "source=project-cache-${devcontainerId},target=/home/vscode/.cache,type=volume",
    "source=${localWorkspaceFolder}/.data,target=/data,type=bind",
  ],
  "customizations": { "vscode": { "extensions": ["ms-python.python"] } },
  "remoteUser": "vscode",
  "postCreateCommand": "pip install --user -r requirements.txt",
}
